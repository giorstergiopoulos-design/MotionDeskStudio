<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <RootNamespace>MotionDesk</RootNamespace>
    <AssemblyName>MotionDesk</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>assets\MotionDesk.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.7.6</Version>
    <AssemblyVersion>1.7.6.0</AssemblyVersion>
    <FileVersion>1.7.6.0</FileVersion>
    <Product>MotionDesk Studio</Product>
    <!-- Ζητήθηκε ρητά "η εφαρμογή να μην περνά ως false positive". Πραγματική, εγγυημένη λύση
         είναι μόνο ένα πληρωμένο code-signing certificate (βλ. PROJECT_STATE.md — παραλείφθηκε
         αυτόν τον γύρο, δεν υπάρχει certificate διαθέσιμο). Χωρίς αυτό, τα παρακάτω είναι η
         καλύτερη δυνατή "υγιεινή" έκδοσης: πλήρη, ρεαλιστικά PE version metadata (οι
         false-positive heuristics πολλών AV βαθμολογούν αρνητικά exe χωρίς Company/Copyright/
         Description) — το project ήδη ΔΕΝ κάνει trimming/single-file/ReadyToRun/obfuscation
         (άλλος συνηθισμένος λόγος false positive), οπότε δεν χρειάζεται αλλαγή εκεί.
    -->
    <Company>MotionDesk Team</Company>
    <Authors>MotionDesk Team</Authors>
    <Copyright>Copyright © 2026 MotionDesk Team</Copyright>
    <Description>MotionDesk Studio — animated desktop wallpaper and workspace customization for Windows.</Description>
  </PropertyGroup>

  <!-- Single native UI stack: WinForms. WPF was removed to reduce framework overhead and complexity. -->
  <ItemGroup>
    <Compile Remove="src\Core\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" ExcludeAssets="build;buildTransitive" GeneratePathProperty="true" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <!-- WinForms-only WebView2 reference: do not import the package's WPF build assets. -->
  <ItemGroup>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="src\Widgets\sysmon\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>widgets\sysmon\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="src\Widgets\wallpaper\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>widgets\wallpaper\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="locales\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>locales\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="assets\MotionDesk.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\MotionDesk.ico</Link>
    </None>
    <None Include="assets\tray\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\tray\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>LICENSE</Link>
    </None>
  </ItemGroup>


  <!-- WebView2 is used through WinForms only. Prevent the package's WPF assembly from entering RAR. -->
  <ItemGroup>
    <Reference Remove="Microsoft.Web.WebView2.Wpf" />
    <Reference Remove="WindowsBase" />
    <Reference Remove="PresentationCore" />
    <Reference Remove="PresentationFramework" />
  </ItemGroup>


  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>

